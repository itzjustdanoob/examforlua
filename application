--!strict

--[[
	CombatController
	============================================================

	This module owns the authoritative combat state for one character.

	The important design decision here is that combat state is stored
	inside the controller instead of being reconstructed from temporary
	instances or animation state. This gives the server one source of
	truth
	for whether a character is attacking, blocking, stunned, or available
	to begin another action.

	The module deliberately separates the combat pipeline into stages:

		1. Validate the requested action.
		2. Advance combo state.
		3. Wait for the attack windup.
		4. Perform spatial hit detection.
		5. Resolve blocking / guard breaking.
		6. Apply damage, stun and movement.
		7. Enter recovery.
		8. Release the attack state.

	Keeping those stages independent means individual mechanics can be
	changed without rewriting the entire attack lifecycle.

	The client should only request an action. The server-side controller
	decides whether that action is legal and what actually happens.
]]

local CombatController = {}
CombatController.__index = CombatController

local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

--============================================================
-- TYPES
--============================================================

export type AttackDefinition = {
	Damage: number,
	Stun: number,

	Windup: number,
	ActiveTime: number,
	Recovery: number,

	HitboxSize: Vector3,
	HitboxOffset: CFrame,

	Knockback: Vector3,

	GuardBreak: boolean?,
	CanHitRagdolled: boolean?,
}

export type CombatConfig = {
	ComboResetTime: number?,
	MaxCombo: number?,

	DefaultWalkSpeed: number?,
	BlockedWalkSpeed: number?,

	DebugHitboxes: boolean?,
}

export type CombatState = {
	Combo: number,
	LastAttackTime: number,

	Attacking: boolean,
	Blocking: boolean,

	StunnedUntil: number,

	AttackId: number,
}

